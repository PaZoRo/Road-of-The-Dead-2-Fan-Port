; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Road of the Dead 2 â€” GDScript Port"
config/description="Road of the Dead 2 fan port with native road projection, vehicle movement, optimized animation, and original assets."
config/version="0.4.23"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.09, 0.065, 1)
boot_splash/show_image=false
config/icon="res://ROD2icon.png"

[debug]

gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=600
window/size/viewport_height=400
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/raw_assets_export/plugin.cfg")

[physics]

common/physics_ticks_per_second=30
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

fan_road_fraction={
"type": "float",
"value": 1.0
}
