static func c1057_f_GetRandomCarSpawnInfo(c: Variant, a: Array) -> Variant:
	var v_iRandom: Variant = 0
	var v_iVar1: Variant = R.coerce((a[0] if a.size() > 0 else 0), "int")
	var v_iVar2: Variant = R.coerce((a[1] if a.size() > 1 else R.unary("-", 1)), "int")
	if R.truth(R.binary("==", v_iVar2, R.unary("-", 1))):
		pass
		v_iVar2 = R.coerce(v_iVar1, "int")
	v_iRandom = R.coerce(R.binary("+", v_iVar1, R.call_static("Maths", "RandomInt", [(float((float(v_iVar2) - float(v_iVar1))) + float(1))])), "int")
	return R.binary("as", R.get_value((R.static_value("RDCarSpawnInfos", "m_AllCarClasses")).fields.get("m_Values"), v_iRandom), R.klass("RDCarSpawnInfo"))
	return null


static func c1057_f_SpawnRandomCar(c: Variant, a: Array) -> Variant:
	var v_carSpawnInfo: Variant = null
	var v_car: Variant = null
	var v_carClass: Variant = R.coerce((a[0] if a.size() > 0 else null), "Class")
	var v_iVar1: Variant = R.coerce((a[1] if a.size() > 1 else 0), "int")
	var v_iVar2: Variant = R.coerce((a[2] if a.size() > 2 else R.unary("-", 1)), "int")
	v_carSpawnInfo = R.coerce(R.call_member(c, "GetRandomCarSpawnInfo", [v_iVar1, v_iVar2]), "RDCarSpawnInfo")
	v_car = R.coerce(R.binary("as", R.call_static("RDGame", "GetEntity", [v_carClass]), R.klass("RDObstacleCar")), "RDObstacleCar")
	R.call_member(v_car, "Init", [(v_carSpawnInfo).fields.get("m_MCClass"), (v_carSpawnInfo).fields.get("m_iMCFrame"), (v_carSpawnInfo).fields.get("m_SoundClass")])
	return v_car
	return null


static func c1060_f_SetInitialState(c: Variant, a: Array) -> Variant:
	R.invoke(R.get_value(R.super_ref(c, "RDEntityWithVoice"), "SetInitialState"), [])
	(c).fields["m_iVoicePriority"] = R.coerce(R.unary("-", 1), "int")
	return null


static func c1060_f_PlayRandomVoice(c: Variant, a: Array) -> Variant:
	var v_voice: Variant = null
	var v_voices: Variant = R.coerce((a[0] if a.size() > 0 else null), "RandomHat")
	var v_fChance: Variant = R.coerce((a[1] if a.size() > 1 else 1), "Number")
	var v_iPriority: Variant = R.coerce((a[2] if a.size() > 2 else 0), "int")
	v_voice = R.coerce(null, "DTSpacialSound")
	if R.truth((float(randf()) < float(v_fChance))):
		pass
		v_voice = R.coerce(R.binary("as", R.call_member(v_voices, "GetRandomValue", []), R.klass("DTSpacialSound")), "DTSpacialSound")
		R.call_member(c, "PlayVoiceSound", [v_voice, v_iPriority])
		return true
	return false
	return null


static func c1060_f_Destroy(c: Variant, a: Array) -> Variant:
	R.invoke(R.get_value(R.super_ref(c, "RDEntityWithVoice"), "Destroy"), [])
	if R.truth((c).fields.get("m_VoiceSound")):
		pass
		R.call_member((c).fields.get("m_VoiceSound"), "SetSoundCompleteCallback", [null])
		(c).fields["m_VoiceSound"] = R.coerce(null, "DTSpacialSound")
	return null


