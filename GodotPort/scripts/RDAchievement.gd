extends RefCounted
const R = preload("res://runtime/as_runtime.gd")

static func f_RDAchievement(c: Variant, a: Array) -> Variant:
	R.invoke(R.super_ref(c, "RDAchievement"), [])
	return null

static func f_InitAchievement(c: Variant, a: Array) -> Variant:
	var v_iAchievement: Variant = R.coerce((a[0] if a.size() > 0 else 0), "int")
	var v_szName: Variant = R.coerce((a[1] if a.size() > 1 else null), "String")
	var v_szHint: Variant = R.coerce((a[2] if a.size() > 2 else null), "String")
	var v_iReward: Variant = R.coerce((a[3] if a.size() > 3 else 0), "int")
	var v_bUseNameForNGMedal: Variant = R.coerce((a[4] if a.size() > 4 else false), "Boolean")
	var v_bUseNameForKongStats: Variant = R.coerce((a[5] if a.size() > 5 else false), "Boolean")
	var v_szArmorGamesQuest: Variant = R.coerce((a[6] if a.size() > 6 else null), "String")
	R.set_value(R.static_value("RDAchievement", "m_Names"), v_iAchievement, v_szName, "=")
	R.set_value(R.static_value("RDAchievement", "m_Hints"), v_iAchievement, v_szHint, "=")
	R.set_value(R.static_value("RDAchievement", "m_Rewards"), v_iAchievement, v_iReward, "=")
	R.set_value(R.static_value("RDAchievement", "m_NGMedals"), v_iAchievement, (v_szName if R.truth(v_bUseNameForNGMedal) else ""), "=")
	R.set_value(R.static_value("RDAchievement", "m_KongStats"), v_iAchievement, (v_szName if R.truth(v_bUseNameForKongStats) else ""), "=")
	R.set_value(R.static_value("RDAchievement", "m_ArmorQuests"), v_iAchievement, v_szArmorGamesQuest, "=")
	return null

