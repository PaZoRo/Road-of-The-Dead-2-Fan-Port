extends SceneTree
const R=preload("res://runtime/as_runtime.gd")
var failures:Array=[]

func expect(value:bool,label:String) -> void:
	if not value:failures.append(label);push_error("ASSERTION_FAILED "+label)

func _initialize() -> void:
	var host:Node=Node.new();root.add_child(host);R.initialize(host)
	var scope:Dictionary={"i":0,"@types":{"i":"int"}}
	R.lset(scope,"i",7.9);expect(R.lget(scope,"i")==7,"integer coercion")
	var a:Array=[10,20,30];expect(R.get_value(a,1.0)==20,"numeric array index")
	expect(R.string(3.0)=="3","AS number to string")
	expect(R.binary("===",R.klass("RDPlayer"),R.klass("RDPlayer")),"class identity")
	expect(R.truth([]),"empty array truthiness")
	expect(not R.truth(NAN),"NaN truthiness")
	expect(R.get_value(R.klass("Number"),"MAX_VALUE")>1e100,"Number.MAX_VALUE")
	var matrix=R.construct(R.klass("Matrix3D"),[])
	R.invoke(R.get_value(matrix,"appendRotation"),[90,R.get_value(R.klass("Vector3D"),"Y_AXIS")])
	var projected=R.invoke(R.get_value(matrix,"transformVector"),[R.construct(R.klass("Vector3D"),[0,0,1])])
	expect(is_equal_approx(R.num(R.get_value(projected,"x")),1),"camera matrix rotation")
	var bitmap=R.construct(R.klass("BitmapData"),[2,2,true,0xffff0000])
	var bitmap_reload=R.decode_save(R.encode_save(bitmap))
	expect(R.native_call(bitmap_reload,"getPixel32",[0,0])==0xffff0000,"bitmap persistence")
	var clip=R.construct(R.klass("MovieClip"),[]);R.add_child(R.stage,clip)
	var basic=R.construct(R.klass("BasicGame"),[clip]);R.invoke(R.get_value(basic,"Init"),[])
	var viewport=R.get_value(basic,"m_Viewport")
	expect(R.get_value(viewport,"m_iHalfWidth")==300,"viewport width")
	expect(R.get_value(viewport,"m_iHalfHeight")==200,"viewport height")
	var entity=R.construct(R.klass("RDEntity"),[])
	expect(R.resolve(entity,"RDEntity","RDEntity").get("@class")=="RDEntity","class name precedes inherited constructor")
	expect(R.get_value(entity,"m_iLayer")==R.get_value(R.klass("RDEntity"),"Layer_Dynamic"),"entity layer constant")
	var shards=R.symbol_instance("7439");R.goto_frame(shards,103,false)
	expect(shards.children.is_empty(),"impact animation final display list")
	var tutorial=R.symbol_instance("8645");var panel=R.get_value(tutorial,"HorizontalKeys")
	R.set_value(panel,"visible",false);R.goto_frame(tutorial,246,false);R.goto_frame(tutorial,1,false)
	expect(R.get_value(tutorial,"HorizontalKeys")==panel,"timeline jump preserves instance")
	expect(not R.get_value(panel,"visible"),"timeline jump preserves scripted visibility")
	for x in [0,0.1,1,10,100]:
		var noise=R.invoke(R.get_value(R.klass("Perlin"),"noise"),[x])
		expect(R.num(noise)>=0 and R.num(noise)<=1,"Perlin range "+str(x)+" = "+str(noise))
		var reference=R.script_for("Perlin").call("f_noise",R.klass("Perlin"),[x])
		expect(is_equal_approx(noise,reference),"optimized noise parity")
	var bytes=R.construct(R.klass("ByteArray"),[])
	R.native_call(bytes,"writeInt",[-123]);R.native_call(bytes,"writeFloat",[1.25]);R.native_call(bytes,"writeUTF",["Road of the Dead 2"])
	R.set_value(bytes,"position",0);expect(R.native_call(bytes,"readInt",[])==-123,"byte integer roundtrip");expect(is_equal_approx(R.native_call(bytes,"readFloat",[]),1.25),"byte float roundtrip");expect(R.native_call(bytes,"readUTF",[])=="Road of the Dead 2","byte UTF roundtrip")
	var saved=R.shared_object("port_test");saved.fields.data={"progress":123,"binary":bytes};R.save_shared(saved)
	var reloaded=R.shared_object("port_test");expect(reloaded.fields.data.get("progress")==123,"save persistence")
	expect(R.get_value(reloaded.fields.data.get("binary"),"length")==R.get_value(bytes,"length"),"binary save persistence")
	expect(R.logical_and(0,func():return 99)==0,"logical and falsy operand")
	expect(R.logical_and("left",func():return "right")=="right","logical and truthy operand")
	expect(R.binary("|",0x80000000,0)==-2147483648,"signed bitwise result")
	var color=R.construct(R.klass("fl.motion.Color"),[])
	R.set_value(color,"brightness",0)
	expect(R.get_value(color,"alphaMultiplier")==1,"native superclass color alpha")
	expect(R.get_value(color,"redMultiplier")==1,"native superclass color identity")
	print("TEST_SEMANTICS_COMPLETE failures="+str(failures))
	R.cleanup();host.queue_free();quit(0 if failures.is_empty() else 1)
